<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0603">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Back"
                app:icon="@android:drawable/ic_menu_back"
                app:iconTint="#FF8C42"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="20dp"
                android:padding="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"/>

            <TextView
                android:text="Settings"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#FF8C42"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:layout_marginStart="16dp"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:text="Scout Information"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FF8C42"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A2F1F"
                android:layout_marginBottom="12dp"/>

            <!-- Name Field -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp">

                <TextView
                    android:text="Scout Name"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF8C42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/scoutNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter your name"
                    android:textColor="#FF8C42"
                    android:textColorHint="#AA6A35"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/settings_input_background"
                    android:inputType="text"
                    tools:ignore="LabelFor"/>

            </LinearLayout>

            <!-- Match Number Field -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp">

                <TextView
                    android:text="Default Match #"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF8C42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/matchNumberInput"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Enter match number"
                    android:textColor="#FF8C42"
                    android:textColorHint="#AA6A35"
                    android:paddingHorizontal="12dp"
                    android:inputType="number"
                    tools:ignore="LabelFor"/>

            </LinearLayout>

            <!-- Position Dropdown -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:text="Default Position"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FF8C42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Select position"
                    app:hintTextColor="#FF8C42"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/positionDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:inputType="none"
                        android:textColor="#FF8C42"
                        android:textColorHint="#AA6A35"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Theme Section -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:text="Theme"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FF8C42"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A2F1F"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/themeRadioGroup"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp">

                    <RadioButton
                        android:id="@+id/darkModeRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FF8C42"/>

                    <TextView
                        android:text="Dark Mode"
                        android:textSize="16sp"
                        android:textColor="#FF8C42"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"/>


                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingVertical="12dp">

                    <RadioButton
                        android:id="@+id/lightModeRadio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FF8C42"/>

                    <TextView
                        android:text="Light Mode"
                        android:textSize="16sp"
                        android:textColor="#FF8C42"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"/>


                </LinearLayout>

            </RadioGroup>

        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#4A2F1F"
            android:layout_marginBottom="24dp"/>

        <!-- Scouting Type Section -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:text="Scouting Input Type"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FF8C42"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#4A2F1F"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/scoutingTypeRadioGroup"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Buckets -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="12dp>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <RadioButton
                            android:id="@+id/bucketsRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FF8C42"/>

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:text="Buckets"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FF8C42"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Click buckets to increment"
                                android:textSize="12sp"
                                android:textColor="#AA6A35"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Manual (+1) -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/settings_option_background">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <RadioButton
                            android:id="@+id/manualRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FF8C42"/>

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:text="Manual (+1)"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FF8C42"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Plus/minus buttons increment by 1"
                                android:textSize="12sp"
                                android:textColor="#AA6A35"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- Slider -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="12dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/settings_option_background">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <RadioButton
                            android:id="@+id/sliderRadio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="#FF8C42"/>

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:text="Slider"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#FF8C42"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"/>

                            <TextView
                                android:text="Drag slider to set value"
                                android:textSize="12sp"
                                android:textColor="#AA6A35"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </RadioGroup>

        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#4A2F1F"
            android:layout_marginBottom="24dp"/>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Settings"
            android:textSize="16sp"
            android:textColor="#0D0603"
            android:textStyle="bold"
            app:backgroundTint="#FF8C42"
            app:cornerRadius="8dp"
            app:elevation="6dp"/>

    </LinearLayout>

</ScrollView>