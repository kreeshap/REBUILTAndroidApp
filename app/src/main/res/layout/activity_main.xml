<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0603">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="ExtraText">

        /title
        <TextView
            android:text="@string/rebuilt_scouting_app"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"/>

        //header
        <LinearLayout
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:paddingBottom="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingEnd="8dp"
                tools:ignore="RtlSymmetry">
                <TextView
                    android:text="@string/name"
                    android:textStyle="bold"
                    android:textColor="#FF8C42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/studentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="text"
                    android:textColor="#FF8C42"
                    android:textColorHint="#AA6A35"
                    android:background="@null"
                    android:paddingBottom="8dp"
                    tools:ignore="LabelFor" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="8dp">
                <TextView
                    android:text="@string/match"
                    android:textStyle="bold"
                    android:textColor="#FF8C42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/matchNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="number"
                    android:textColor="#FF8C42"
                    android:textColorHint="#AA6A35"
                    android:background="@null"
                    android:paddingBottom="8dp"
                    tools:ignore="LabelFor" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="8dp"
                tools:ignore="RtlSymmetry">
                <TextView
                    android:text="@string/team"
                    android:textStyle="bold"
                    android:textColor="#FF8C42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/teamNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="number"
                    android:textColor="#FF8C42"
                    android:textColorHint="#AA6A35"
                    android:background="@null"
                    android:paddingBottom="8dp"
                    tools:ignore="LabelFor" />
            </LinearLayout>
        </LinearLayout>

        //seperator
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4A2F1F"
            android:layout_marginBottom="16dp"/>

        //auto
        <TextView
            android:text="@string/autonomous"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="12dp">
            <CheckBox
                android:id="@+id/autoL1Hang"
                android:text="@string/l1_hang"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="32dp"
                tools:ignore="RtlSymmetry" />
            <CheckBox
                android:id="@+id/autoBallCollector"
                android:text="@string/ball_collector"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:text="@string/fuel_scored"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        //auto fuel counter
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/autoFuelMinus3"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="-3"
                    android:textSize="14sp"
                    android:textColor="#0D0603"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:elevation="4dp"
                    app:backgroundTint="#FF8C42"
                    app:cornerRadius="20dp"
                    android:contentDescription="Decrease by 3"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/autoFuelMinus1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="-1"
                    android:textSize="14sp"
                    android:textColor="#0D0603"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:elevation="4dp"
                    app:backgroundTint="#FF8C42"
                    app:cornerRadius="20dp"
                    android:contentDescription="Decrease by 1"/>

                <TextView
                    android:id="@+id/autoFuel1"
                    android:text="0"
                    android:textColor="#FF8C42"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="18sp"
                    android:layout_marginHorizontal="8dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/autoFuelPlus1"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+1"
                    android:textSize="14sp"
                    android:textColor="#0D0603"
                    android:layout_marginEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:elevation="4dp"
                    app:backgroundTint="#FF8C42"
                    app:cornerRadius="20dp"
                    android:contentDescription="Increase by 1"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/autoFuelPlus3"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+3"
                    android:textSize="14sp"
                    android:textColor="#0D0603"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    app:elevation="4dp"
                    app:backgroundTint="#FF8C42"
                    app:cornerRadius="20dp"
                    android:contentDescription="Increase by 3"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp">
            <LinearLayout
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="16dp"
                android:weightSum="2">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingHorizontal="8dp">
                    <TextView
                        android:text="Bump"
                        android:textColor="#FF8C42"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center">
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/autoBumpPlus1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="TODO"
                            app:srcCompat="@android:drawable/ic_input_add"
                            app:fabCustomSize="40dp"
                            android:layout_marginEnd="8dp"
                            app:elevation="4dp"
                            app:backgroundTint="#FF8C42"
                            app:tint="#0D0603"/>
                        <TextView
                            android:id="@+id/autoFuel1"
                            android:text="0"
                            android:textColor="#FF8C42"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="18sp"/>
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/autoBumpMinus1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_minus"
                            app:fabCustomSize="40dp"
                            android:layout_marginStart="8dp"
                            app:elevation="4dp"
                            app:backgroundTint="#FF8C42"
                            app:tint="#0D0603"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingHorizontal="8dp">
                    <TextView
                        android:text="Trench"
                        android:textColor="#FF8C42"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingBottom="8dp"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center">
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/autoTrenchPlus1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@android:drawable/ic_input_add"
                            app:fabCustomSize="40dp"
                            android:layout_marginEnd="8dp"
                            app:elevation="4dp"
                            app:backgroundTint="#FF8C42"
                            app:tint="#0D0603"/>
                        <TextView
                            android:id="@+id/autoFuel3"
                            android:text="0"
                            android:textColor="#FF8C42"
                            android:layout_width="36dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textSize="18sp"/>
                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/autoTrenchMinus1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:srcCompat="@drawable/ic_minus"
                            app:fabCustomSize="40dp"
                            android:layout_marginStart="8dp"
                            app:elevation="4dp"
                            app:backgroundTint="#FF8C42"
                            app:tint="#0D0603"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:weightSum="2">

            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4A2F1F"
            android:layout_marginBottom="16dp"/>

        //teleop
        <TextView
            android:text="TeleOp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"/>

        <TextView
            android:text="Fuel Scored"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        //teleop fuel
