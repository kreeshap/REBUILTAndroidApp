<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0603">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Top Buttons -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/historyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_recent_history"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                app:tint="#FF8C42"/>

            <ImageButton
                android:id="@+id/settingsButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_settings"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:layout_marginStart="8dp"
                app:tint="#FF8C42" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:text="@string/rebuilt_scouting_app"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"/>

        <!-- Header Section -->
        <LinearLayout
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="3"
            android:paddingBottom="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="8dp">
                <TextView
                    android:text="@string/match"
                    android:textStyle="bold"
                    android:textColor="#FF8C42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/matchNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="number"
                    android:textColor="#FF8C42"
                    android:textColorHint="#AA6A35"
                    android:background="@null"
                    android:paddingBottom="8dp"
                    tools:ignore="LabelFor" />
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingHorizontal="8dp">
                <TextView
                    android:text="@string/team"
                    android:textStyle="bold"
                    android:textColor="#FF8C42"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <EditText
                    android:id="@+id/teamNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints=""
                    android:inputType="number"
                    android:textColor="#FF8C42"
                    android:textColorHint="#AA6A35"
                    android:background="@null"
                    android:paddingBottom="8dp"
                    tools:ignore="LabelFor" />
            </LinearLayout>

        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4A2F1F"
            android:layout_marginBottom="16dp"/>

        <!-- Autonomous Section -->
        <TextView
            android:text="@string/autonomous"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="12dp">
            <CheckBox
                android:id="@+id/autoL1Hang"
                android:text="@string/l1_hang"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="32dp"
                tools:ignore="RtlSymmetry" />
            <CheckBox
                android:id="@+id/autoBallCollector"
                android:text="@string/ball_collector"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <TextView
            android:text="@string/fuel_scored"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- Auto Fuel Counter -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/autoFuelMinus3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-3"
                android:textSize="14sp"
                android:textColor="#0D0603"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:elevation="4dp"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="20dp"
                android:contentDescription="Decrease by 3"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/autoFuelMinus1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-1"
                android:textSize="14sp"
                android:textColor="#0D0603"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:elevation="4dp"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="20dp"
                android:contentDescription="Decrease by 1"/>

            <TextView
                android:id="@+id/autoFuel1"
                android:text="0"
                android:textColor="#FF8C42"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="18sp"
                android:layout_marginHorizontal="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/autoFuelPlus1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+1"
                android:textSize="14sp"
                android:textColor="#0D0603"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:elevation="4dp"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="20dp"
                android:contentDescription="Increase by 1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/autoFuelPlus3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+3"
                android:textSize="14sp"
                android:textColor="#0D0603"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:elevation="4dp"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="20dp"
                android:contentDescription="Increase by 3"/>
        </LinearLayout>

        <!-- Auto Bump and Trench Counters -->
        <LinearLayout
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:weightSum="2">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="8dp">
                <TextView
                    android:text="Bump"
                    android:textColor="#FF8C42"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/autoBumpPlus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Increase bump"
                        app:srcCompat="@android:drawable/ic_input_add"
                        app:fabCustomSize="40dp"
                        android:layout_marginEnd="8dp"
                        app:elevation="4dp"
                        app:backgroundTint="#FF8C42"
                        app:tint="#0D0603"/>
                    <TextView
                        android:id="@+id/autoBumpDisplay"
                        android:text="0"
                        android:textColor="#FF8C42"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="18sp" />
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/autoBumpMinus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Decrease bump"
                        app:srcCompat="@drawable/ic_minus"
                        app:fabCustomSize="40dp"
                        android:layout_marginStart="8dp"
                        app:elevation="4dp"
                        app:backgroundTint="#FF8C42"
                        app:tint="#0D0603"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="8dp">
                <TextView
                    android:text="Trench"
                    android:textColor="#FF8C42"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/autoTrenchPlus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Increase trench"
                        app:srcCompat="@android:drawable/ic_input_add"
                        app:fabCustomSize="40dp"
                        android:layout_marginEnd="8dp"
                        app:elevation="4dp"
                        app:backgroundTint="#FF8C42"
                        app:tint="#0D0603"/>
                    <TextView
                        android:id="@+id/autoTrenchDisplay"
                        android:text="0"
                        android:textColor="#FF8C42"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="18sp"/>
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/autoTrenchMinus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Decrease trench"
                        app:srcCompat="@drawable/ic_minus"
                        app:fabCustomSize="40dp"
                        android:layout_marginStart="8dp"
                        app:elevation="4dp"
                        app:backgroundTint="#FF8C42"
                        app:tint="#0D0603"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Separator -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4A2F1F"
            android:layout_marginBottom="16dp"/>

        <!-- TeleOp Section -->
        <TextView
            android:text="TeleOp"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"/>

        <TextView
            android:text="Fuel Scored"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="8dp"/>

        <!-- TeleOp Fuel Counter -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:paddingBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/teleFuelMinus3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-3"
                android:textSize="14sp"
                android:textColor="#0D0603"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:elevation="4dp"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="20dp"
                android:contentDescription="Decrease by 3"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/teleFuelMinus1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-1"
                android:textSize="14sp"
                android:textColor="#0D0603"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:elevation="4dp"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="20dp"
                android:contentDescription="Decrease by 1"/>

            <TextView
                android:id="@+id/teleFuel1"
                android:text="0"
                android:textColor="#FF8C42"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="18sp"
                android:layout_marginHorizontal="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/teleFuelPlus1"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+1"
                android:textSize="14sp"
                android:textColor="#0D0603"
                android:layout_marginEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:elevation="4dp"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="20dp"
                android:contentDescription="Increase by 1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/teleFuelPlus3"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="+3"
                android:textSize="14sp"
                android:textColor="#0D0603"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:padding="0dp"
                app:elevation="4dp"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="20dp"
                android:contentDescription="Increase by 3"/>
        </LinearLayout>

        <!-- TeleOp Bump and Trench Counters -->
        <LinearLayout
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="16dp"
            android:weightSum="2">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="8dp">
                <TextView
                    android:text="Bump"
                    android:textColor="#FF8C42"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/teleBumpPlus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Increase bump"
                        app:srcCompat="@android:drawable/ic_input_add"
                        app:fabCustomSize="40dp"
                        android:layout_marginEnd="8dp"
                        app:elevation="4dp"
                        app:backgroundTint="#FF8C42"
                        app:tint="#0D0603"/>
                    <TextView
                        android:id="@+id/teleBumpDisplay"
                        android:text="0"
                        android:textColor="#FF8C42"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="18sp"/>
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/teleBumpMinus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Decrease bump"
                        app:srcCompat="@drawable/ic_minus"
                        app:fabCustomSize="40dp"
                        android:layout_marginStart="8dp"
                        app:elevation="4dp"
                        app:backgroundTint="#FF8C42"
                        app:tint="#0D0603"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="8dp">
                <TextView
                    android:text="Trench"
                    android:textColor="#FF8C42"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/teleTrenchPlus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Increase trench"
                        app:srcCompat="@android:drawable/ic_input_add"
                        app:fabCustomSize="40dp"
                        android:layout_marginEnd="8dp"
                        app:elevation="4dp"
                        app:backgroundTint="#FF8C42"
                        app:tint="#0D0603"/>
                    <TextView
                        android:id="@+id/teleTrench"
                        android:text="0"
                        android:textColor="#FF8C42"
                        android:layout_width="36dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textSize="18sp"/>
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/teleTrenchMinus1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Decrease trench"
                        app:srcCompat="@drawable/ic_minus"
                        app:fabCustomSize="40dp"
                        android:layout_marginStart="8dp"
                        app:elevation="4dp"
                        app:backgroundTint="#FF8C42"
                        app:tint="#0D0603"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Match Share Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Match Share"
            android:textSize="18sp"
            android:textColor="#FF8C42"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:layout_marginTop="16dp"/>

        <!-- Match Share Table -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#4A2F1F">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shift"
                    android:textColor="#FF8C42"
                    android:textStyle="bold"
                    android:textSize="13sp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Passing"
                    android:textColor="#FF8C42"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Defense"
                    android:textColor="#FF8C42"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scoring"
                    android:textColor="#FF8C42"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cycling"
                    android:textColor="#FF8C42"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Shift 1 Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#1A1410">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shift 1"
                    android:textColor="#FF8C42"
                    android:textSize="14sp"/>

                <CheckBox
                    android:id="@+id/shift1_passing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:buttonTint="#FF8C42"/>

                <CheckBox
                    android:id="@+id/shift1_defense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:buttonTint="#FF8C42"/>

                <CheckBox
                    android:id="@+id/shift1_scoring"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:buttonTint="#FF8C42"/>

                <CheckBox
                    android:id="@+id/shift1_cycling"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:buttonTint="#FF8C42"/>
            </LinearLayout>

            <!-- Shift 2 Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#0D0603">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Shift 2"
                    android:textColor="#FF8C42"
                    android:textSize="14sp"/>

                <CheckBox
                    android:id="@+id/shift2_passing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:buttonTint="#FF8C42"/>

                <CheckBox
                    android:id="@+id/shift2_defense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/shift2_scoring"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/shift2_cycling"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>
                </LinearLayout>

                //shift 3 row
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Shift 3"
                        android:textColor="#FF8C42"
                        android:textSize="14sp"/>

                    <CheckBox
                        android:id="@+id/shift3_passing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/shift3_defense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/shift3_scoring"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/shift3_cycling"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>
                </LinearLayout>

                //shift 4 row
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Shift 4"
                        android:textColor="#FF8C42"
                        android:textSize="14sp"/>

                    <CheckBox
                        android:id="@+id/shift4_passing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/shift4_defense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/shift4_scoring"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/shift4_cycling"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>
                </LinearLayout>

                //endgame row
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Endgame"
                        android:textColor="#FF8C42"
                        android:textSize="14sp"/>

                    <CheckBox
                        android:id="@+id/endgame_passing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/endgame_defense"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/endgame_scoring"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>

                    <CheckBox
                        android:id="@+id/endgame_cycling"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:buttonTint="#FF8C42"/>


                </LinearLayout>

            </LinearLayout>

        </LinearLayout>





        //endgame fuel
        <TextView
            android:text="Endgame"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"/>

        //endgame fuel
        <RadioGroup
            android:id="@+id/hangRadioGroup"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingTop="8dp">

            <RadioButton
                android:id="@+id/endNoHang"
                android:text="@string/no_hang"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/endL1"
                android:text="L1 Hang"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/endL2"
                android:text="@string/l2_hang"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/endL3"
                android:text="@string/l3_hang"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RadioGroup>

        <RadioGroup
            android:id="@+id/positionRadioGroup"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_gravity="center"
            android:paddingTop="8dp">

            <RadioButton
                android:id="@+id/none"
                android:text="N/A"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/endcenter"
                android:text="Center"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/endleft"
                android:text="Left"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/endright"
                android:text="Right"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <RadioButton
                android:id="@+id/endback"
                android:text="Back"
                android:textColor="#FF8C42"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RadioGroup>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Comments:"
            android:textSize="18sp"
            android:textColor="#FF8C42"
            android:gravity="center"
            android:paddingBottom="12dp" >
        </TextView>

        <EditText
            android:id="@+id/Comments"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:inputType="text"
            android:textColor="#FF8C42"
            android:textColorHint="#AA6A35"
            android:background="@null"
            android:paddingBottom="8dp"
            tools:ignore="LabelFor" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#4A2F1F"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        //buttons
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="24dp"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/qrCodeButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="QR Code"
                android:textSize="16sp"
                android:textColor="#0D0603"
                android:textStyle="bold"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="8dp"
                app:elevation="6dp"
                android:onClick="generateQRCode"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/submitButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Submit"
                android:textSize="16sp"
                android:textColor="#0D0603"
                android:textStyle="bold"
                app:backgroundTint="#FF8C42"
                app:cornerRadius="8dp"
                app:elevation="6dp"
                android:onClick="onSubmit"/>

        </LinearLayout>


    </ScrollView>

</ScrollView>